# Custom OpenAI-compatible chat API. No real key is included.
# Option A: base URL INCLUDING your provider's version prefix.
LLM_BASE_URL=https://your-company-host.example/v1
# Option B: exact full endpoint; when set this overrides BASE_URL.
LLM_ENDPOINT_URL=
LLM_API_KEY=
LLM_MODEL=your-chat-model
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
# Leave blank if your model does not accept temperature.
LLM_TEMPERATURE=0.2
# Optional non-secret provider request fields, e.g. {"max_completion_tokens":64}
LLM_EXTRA_BODY_JSON={}

# Used by index-policies and reviews when POLICY_SEARCH_ENABLED=true.
EMBEDDING_BASE_URL=https://your-company-host.example/v1
EMBEDDING_ENDPOINT_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_AUTH_HEADER=Authorization
EMBEDDING_AUTH_SCHEME=Bearer
# Blank omits dimensions (many providers do not accept it).
EMBEDDING_DIMENSIONS=
# Standard request: {"model":"...", "input":["..."]}
EMBEDDING_INPUT_FIELD=input
EMBEDDING_INPUT_AS_LIST=true
EMBEDDING_VECTOR_PATH=data.0.embedding
EMBEDDING_EXTRA_BODY_JSON={}

HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=3
# Optional path to your corporate CA bundle. TLS verification remains enabled.
CA_BUNDLE=

# Legacy HTTP mode only: used when DATABASE_URL is blank.
CARD_BASE_URL=http://127.0.0.1:8011
TRAVEL_BASE_URL=http://127.0.0.1:8012
HR_BASE_URL=http://127.0.0.1:8013
LEDGER_BASE_URL=http://127.0.0.1:8014
MOCK_CARD_PORT=8011
MOCK_TRAVEL_PORT=8012
MOCK_HR_PORT=8013
MOCK_LEDGER_PORT=8014
MOCK_CARD_FAIL_EVERY=10
MOCK_TRAVEL_DELAY_SECONDS=0.15
FX_BASE_URL=https://api.frankfurter.dev/v1
FX_CACHE_PATH=runtime/fx-cache.sqlite3

# Optional paths; defaults are project resources and receipts directories.
# POLICY_RESOURCE_DIR=C:/path/to/tripledger/mcp_server/resources
# RECEIPT_ROOT=C:/path/to/tripledger/receipts

# PNG/JPEG extraction via the configured LLM API. JSON fixtures need no API.
RECEIPT_VISION_ENABLED=false
# Blank uses LLM_MODEL. Set only if your gateway requires a different vision model.
VISION_MODEL=

# Python always runs locally. SQL and pgvector use the same PostgreSQL URL.
# Option A: PostgreSQL installed on Windows (no Docker needed).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/tripledger
# Option B: optional Docker database published on port 5433.
# DATABASE_URL=postgresql://tripledger:YOUR_PASSWORD@127.0.0.1:5433/tripledger
# Choose exactly one URL. URI-encode special password characters: @=%40, #=%23, %=%25.
POLICY_SEARCH_ENABLED=true

# Used ONLY if you choose the optional Docker database.
DOCKER_POSTGRES_PORT=5433
DOCKER_POSTGRES_DB=tripledger
DOCKER_POSTGRES_USER=tripledger
DOCKER_POSTGRES_PASSWORD=replace-with-your-docker-database-password
