# Copy to .env. Run scripts/configure.py once to generate local secrets.
# Application services run on your computer. Docker is optional infrastructure only.
DB_USER=tripledger
DB_PASSWORD=CHANGE_ME
# Docker PostgreSQL option uses 5433. Use 5432 for your local PostgreSQL instead.
IDENTITY_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/tripledger_identity
EXPENSE_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/tripledger_expense
POLICY_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/tripledger_policy
AI_DATABASE_URL=postgresql://tripledger:CHANGE_ME@127.0.0.1:5433/tripledger_ai
DOCKER_POSTGRES_PORT=5433
# Used for service-to-service requests. Generate a random value of 32+ characters.
SERVICE_KEY=CHANGE_ME
BOOTSTRAP_ADMIN_EMAIL=admin@tripledger.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BIND_ADDRESS=127.0.0.1
IDENTITY_URL=http://127.0.0.1:8081
EXPENSE_URL=http://127.0.0.1:8082
POLICY_URL=http://127.0.0.1:8083
AI_URL=http://127.0.0.1:8090
GATEWAY_URL=http://127.0.0.1:8080
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=tripledger
RABBIT_PASSWORD=CHANGE_ME

# Your company OpenAI-compatible API. Full endpoint overrides base URL.
LLM_BASE_URL=https://your-company-host.example/v1
LLM_ENDPOINT_URL=
LLM_API_KEY=
LLM_MODEL=your-chat-model
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
# Leave empty if the model rejects temperature.
LLM_TEMPERATURE=
LLM_EXTRA_BODY_JSON={}
EMBEDDING_BASE_URL=https://your-company-host.example/v1
EMBEDDING_ENDPOINT_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_AUTH_HEADER=Authorization
EMBEDDING_AUTH_SCHEME=Bearer
EMBEDDING_DIMENSIONS=
EMBEDDING_INPUT_FIELD=input
EMBEDDING_INPUT_AS_LIST=true
EMBEDDING_VECTOR_PATH=data.0.embedding
EMBEDDING_EXTRA_BODY_JSON={}
HTTP_TIMEOUT_SECONDS=120
CA_BUNDLE=
# Enable only when your configured chat/vision model supports image input.
RECEIPT_VISION_ENABLED=false
VISION_MODEL=
FX_BASE_URL=https://api.frankfurter.dev/v1
