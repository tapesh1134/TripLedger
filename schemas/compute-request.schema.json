{
  "$defs": {
    "Cap": {
      "additionalProperties": false,
      "description": "Caller supplies policy values. A limit is per unit; quantity is explicit.",
      "properties": {
        "line_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "cap_excess",
            "whole_line"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "quantity": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "line_id",
        "rule_id",
        "kind"
      ],
      "title": "Cap",
      "type": "object"
    },
    "ComputeLine": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "amount",
        "currency"
      ],
      "title": "ComputeLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "lines": {
      "items": {
        "$ref": "#/$defs/ComputeLine"
      },
      "minItems": 1,
      "title": "Lines",
      "type": "array"
    },
    "caps": {
      "items": {
        "$ref": "#/$defs/Cap"
      },
      "title": "Caps",
      "type": "array"
    },
    "base_currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Base Currency",
      "type": "string"
    }
  },
  "required": [
    "lines",
    "caps",
    "base_currency"
  ],
  "title": "ComputeRequest",
  "type": "object"
}
